// PostgreSQL (Supabase em produção, container `db` do docker-compose em dev).
// Adapter de runtime em src/lib/db.ts; URL de migração em prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String      @id // ex: "c", "grafica-3d"
  name        String
  icon        String
  description String
  order       Int         @default(0)
  challenges  Challenge[]
}

model Challenge {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  tags          Json // string[]
  difficulty    Int // 1..5
  kind          String // "stdio" | "shader" | "canvas"
  checker       Json // { type: "exact" } | { type: "ppm", tolerance, maxBadRatio }
  statement     String // Markdown
  notes         String? // Markdown: notas do professor
  hints         Json // string[] (Markdown)
  languages     Json // LanguageId[]
  templates     Json // Record<LanguageId, string>
  solutions     Json // Record<LanguageId, string>
  timeLimitMs   Int
  memoryLimitMb Int
  order         Int              @default(0)
  sourceDir     String? // diretório em /challenges (null = criado pela web)
  tests         TestCase[]
  progress      Progress[]
  drafts        Draft[]
  comments      Comment[]
  submissions   Submission[]
  dailies       DailyChallenge[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
}

model TestCase {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  input       String
  expected    String
  hidden      Boolean
  order       Int

  @@index([challengeId])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ---- Fase 2: contas, convites, progresso e rascunhos

model User {
  id           String           @id @default(cuid())
  username     String           @unique // minúsculo, [a-z0-9_-]{3,20}
  passwordHash String? // null = só entra pelo GitHub
  githubId     String?          @unique
  isAdmin      Boolean          @default(false)
  settings     Json? // preferências do editor (ver src/lib/client/store.ts)
  createdAt    DateTime         @default(now())
  sessions     Session[]
  progress     Progress[]
  drafts       Draft[]
  guestbook    GuestbookEntry[]
  comments     Comment[]
  submissions  Submission[]
  invitesMade  Invite[]         @relation("InviteCreator")
  inviteUsed   Invite?          @relation("InviteUser")
  apiTokens    ApiToken[]
}

model Session {
  id        String   @id // sha256 do token do cookie (o token em si não fica no banco)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  code        String    @id
  isAdmin     Boolean   @default(false) // quem usar vira admin
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Progress {
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  state         String? // null (em andamento) | "solved" | "gaveup"
  hintsRevealed Int       @default(0)
  gaveUp        Boolean   @default(false) // já viu a solução antes de resolver
  points        Int       @default(0)
  dailyBonus    Boolean   @default(false) // resolvido no dia em que era o desafio do dia (Fase 5)
  solvedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([userId, challengeId])
  @@index([challengeId])
}

model Draft {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language    String
  code        String
  updatedAt   DateTime  @updatedAt

  @@id([userId, challengeId, language])
}

// ---- Fase 3: trilhas, guestbook, comentários e soluções dos jogadores

model Track {
  id          String @id // slug, vem de challenges/tracks.yml
  title       String
  description String
  steps       Json // string[]: slugs dos desafios, na ordem
  order       Int    @default(0)
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String // texto puro (ver src/components/UserText.tsx)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Comment {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String // texto puro; ||assim|| vira spoiler
  createdAt   DateTime  @default(now())

  @@index([challengeId, createdAt])
}

// Último código aprovado de cada jogador, por desafio e linguagem.
// Alimenta "soluções dos outros" (Fase 3) e os recordes (Fase 5).
model Submission {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language    String
  code        String
  bytes       Int // tamanho do código em bytes UTF-8
  timeMs      Int? // pior tempo entre os testes (null se o runner não mede)
  updatedAt   DateTime  @updatedAt

  @@id([userId, challengeId, language])
  @@index([challengeId])
}

// ---- Fase 5: desafio do dia (sorteado na primeira visita de cada dia)

model DailyChallenge {
  day         String    @id // "AAAA-MM-DD" no fuso do site
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

// ---- Fase 6: tokens da CLI (korin login). O token em si só aparece uma vez,
// na criação; o banco guarda o sha256 e um prefixo para o usuário reconhecer.

model ApiToken {
  id         String    @id // sha256 do token (como em Session)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // apelido dado pelo usuário (ex.: "notebook")
  prefix     String // primeiros caracteres do token, para listar sem revelar
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
