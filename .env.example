# Banco PostgreSQL.
# Local (docker compose up -d db):
DATABASE_URL="postgresql://korin:korin@localhost:5432/korin"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = pooler "Transaction" (porta 6543), usado pelo app na Vercel
#   DIRECT_URL   = conexão direta ou pooler "Session" (porta 5432), usado por migrate/seed
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:5432/postgres"

# Runner de código (onde os desafios stdio e o /compilador compilam e executam):
#   "godbolt" - API pública do Compiler Explorer (sem servidor para manter;
#               padrão zero-config, veja limitações em src/lib/runner/godbolt.ts)
#   "piston"  - sandbox própria via Docker (recomendado com tráfego)
#   "local"   - compila e executa NA SUA MÁQUINA, SEM SANDBOX. Só em dev, sozinho.
RUNNER="godbolt"
# GODBOLT_URL="https://godbolt.org"
# PISTON_URL aceita a raiz do serviço (http://piston:2000) ou a URL completa do
# execute (https://host/api/v2/piston/execute, quando o Piston mora atrás de
# proxy com caminho). Em produção sem PISTON_URL o site falha com erro claro.
# PISTON_URL="http://localhost:2000"
# Piston remoto atrás de proxy com token (enviado como Authorization: Bearer ...)
# PISTON_TOKEN=""
# Com RUNNER=piston, se o Piston estiver fora do ar o site cai para o Compiler
# Explorer e avisa na resposta. "none" desliga essa reserva.
# RUNNER_FALLBACK="none"
# Runtimes embutidos na imagem do Piston (docker compose build piston).
# gcc cobre C, C++, D e Fortran. A primeira build baixa ~2 GB por causa do gcc.
# PISTON_PACKAGES="gcc,rust,go,zig,nasm,pascal"

# C/C++ (stdio e canvas raylib/SDL2) compilam no navegador (Emception). Para servir a
# toolchain você mesmo em vez do jsDelivr, copie a pasta cdn/ de @gameguild/emception-toolchain:
# NEXT_PUBLIC_EMCEPTION_MANIFEST_URL="https://seu-cdn/emception/manifest.json"

# Necessário para usar RUNNER=local com NODE_ENV=production (não faça isso).
# ALLOW_UNSAFE_LOCAL_RUNNER="1"

# URL pública do site (sem barra no fim). Necessária para o login com GitHub.
APP_URL="http://localhost:3000"

# Primeiro admin sem acesso ao banco: cadastre-se em /entrar usando este valor como
# código de convite. Só funciona enquanto não existe admin. Mínimo 16 caracteres.
#   openssl rand -hex 16
# ADMIN_BOOTSTRAP_CODE=""

# Login com GitHub (opcional): crie um OAuth App em github.com/settings/developers
# com callback  <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Execuções por minuto por usuário logado (ou por IP sem login) / execuções simultâneas no servidor
RUN_RATE_PER_MINUTE="20"
RUN_MAX_CONCURRENCY="4"

# Quem confere o :submit de C/C++ (tudo compila no navegador de qualquer jeito).
# "client" (padrão): o navegador roda inclusive os testes ocultos (recebe só o hash
# da resposta) e o servidor só registra; nada é compilado nem executado aqui.
# "server": o navegador manda o .wasm e o servidor roda os ocultos (worker_threads).
# NEXT_PUBLIC_SUBMIT_VERIFY="client"
