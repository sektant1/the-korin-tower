# Banco PostgreSQL.
# Local (docker compose up -d db):
DATABASE_URL="postgresql://korin:korin@localhost:5432/korin"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = pooler "Transaction" (porta 6543), usado pelo app na Vercel
#   DIRECT_URL   = conexão direta ou pooler "Session" (porta 5432), usado por migrate/seed
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:5432/postgres"

# Runner de código: "piston" (sandbox via Docker, recomendado) ou "local"
# "local" compila e executa NA SUA MÁQUINA, SEM SANDBOX. Use só em dev, sozinho.
RUNNER="piston"
PISTON_URL="http://localhost:2000"
# Piston remoto atrás de proxy com token (enviado como Authorization: Bearer ...)
# PISTON_TOKEN=""

# Necessário para usar RUNNER=local com NODE_ENV=production (não faça isso).
# ALLOW_UNSAFE_LOCAL_RUNNER="1"

# URL pública do site (sem barra no fim). Necessária para o login com GitHub.
APP_URL="http://localhost:3000"

# Primeiro admin sem acesso ao banco: cadastre-se em /entrar usando este valor como
# código de convite. Só funciona enquanto não existe admin. Mínimo 16 caracteres.
#   openssl rand -hex 16
# ADMIN_BOOTSTRAP_CODE=""

# Login com GitHub (opcional): crie um OAuth App em github.com/settings/developers
# com callback  <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Execuções por minuto por usuário logado (ou por IP sem login) / execuções simultâneas no servidor
RUN_RATE_PER_MINUTE="20"
RUN_MAX_CONCURRENCY="4"
